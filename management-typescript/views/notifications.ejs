<%- include('partials/head') %><header class="page-header"><h1><%= title %></h1></header><section class="card"><h2><%= user.role==='admin'?'Farmer Account Activity':'Notifications' %></h2><% if(!notifications.length){ %><p>No notifications yet.</p><% } %><% for(const n of notifications){ %><article class="notice <%= n.is_read?'':'unread' %>"><p><%= user.role==='admin'?n.detail:n.message %></p><small><%= user.role==='admin'?n.activity_time:n.created_at %></small><% if(!n.is_read){ %><form action="<%= user.role==='admin'?'/activities/read':'/notifications/'+n.id+'/read' %>" method="post"><%- include('partials/csrf') %><% if(user.role==='admin'){ %><input type="hidden" name="activity_key" value="<%= n.activity_key %>"><% } %><button>Mark as read</button></form><% } %></article><% } %></section>
<section class="card"><h2>Digital Distribution Receipts</h2><% if(!batches.length){ %><p>No pending distribution receipts.</p><% } %><% for(const batch of batches){const first=batch[0]; %><article class="receipt-card"><h3>REC-<%= String(first.id).padStart(6,'0') %></h3><p><%= first.fullname %> · <%= first.created_at %> · Pending</p><div class="table-wrap"><table><thead><tr><th>Resource</th><th>Quantity</th><th>Unit</th></tr></thead><tbody><% for(const d of batch){ %><tr><td><%= d.resource_name %></td><td><%= d.allocated_quantity %></td><td><%= d.unit %></td></tr><% } %></tbody></table></div><a class="button" href="/receipts/<%= first.id %>">💾 Save / Print Receipt</a><% if(user.role==='farmer'){ %><form action="/receipts/confirm" method="post" enctype="multipart/form-data" data-confirm="Confirm receipt with this proof image?"><%- include('partials/csrf') %><input type="hidden" name="batch_received_at" value="<%= first.created_at %>"><label>Proof image (JPG, PNG, WEBP, 5 MB maximum)<input type="file" name="proof" accept="image/jpeg,image/png,image/webp" required></label><button>✓ Confirm Receipt</button></form><% } %></article><% } %></section><%- include('partials/foot') %>
