<%- include('partials/head') %><section class="card"><h1>FARMER'S PROFILE</h1><% if(profile.profile_pic&&profile.profile_pic!=='default.png'){ %><img class="profile-photo" src="/images/profile/<%= profile.id %>" alt="Profile photo"><% } %><dl class="profile-details"><% for(const [label,key] of [['Registry Reference ID','id'],['Full Name','fullname'],['Date of Birth','birthdate'],['Age','age'],['Gender','gender'],['Civil Status','civil_status'],['Place of Birth','place_of_birth'],['Home Address','address'],['Contact Number','contact_number'],['Land Owned (Hectares)','hectares']]){ %><dt><%= label %></dt><dd><%= profile[key]??'N/A' %></dd><% } %></dl><% if(user.role==='admin'){ %><a href="/farmers?edit=<%= profile.id %>">Edit Farmer</a> · <a href="/profile?id=<%= profile.id %>&view_history=1">View Activity History</a> · <a href="/farmers">Back to Farmers</a><% } %></section>
<% if(viewHistory){ %><section class="card"><h2>Resource Allocations / Distributions</h2><%- include('partials/distributions',{records:allocations}) %></section><section class="card"><h2>Logged Complaints</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Subject</th><th>Message</th></tr></thead><tbody><% for(const c of complaints){ %><tr><td><%= c.created_at %></td><td><%= c.subject %></td><td><%= c.message %></td></tr><% } %></tbody></table></div></section><% } %><%- include('partials/foot') %>
