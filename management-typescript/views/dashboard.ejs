<%- include('partials/head') %><header class="page-header"><h1>Welcome back, <%= user.fullname %>!</h1><p>Manage farm resources and monitor distribution activity.</p></header>
<div class="stats-grid"><% const cards=user.role==='admin'?[['Active Farmers',stats.farmers],['Registered Hectares',stats.hectares],['Active Resources',stats.resources],['Pending Distributions',stats.pending]]:[['My Hectares',stats.hectares],['Allocation Records',stats.records],['Pending Distributions',stats.pending],['Received',stats.received]];for(const [label,value] of cards){ %><div class="stat-card"><strong><%= value %></strong><span><%= label %></span></div><% } %></div>
<section class="card"><h2>Distributed Resources by Date</h2><div class="bar-chart"><% const max=Math.max(1,...chart.map(c=>Number(c.total_quantity)));for(const c of chart){ %><div class="bar-row"><span><%= c.distribution_date %></span><meter min="0" max="<%= max %>" value="<%= c.total_quantity %>"><%= c.total_quantity %></meter><span><%= c.total_quantity %> quantity (<%= c.distribution_count %> records)</span></div><% } %><% if(!chart.length){ %><p>No distributions recorded.</p><% } %></div></section>
<section class="card"><h2><%= user.role==='admin'?'Recent Distribution Activity':'My Recent Resource Allocations' %></h2><%- include('partials/distributions',{records}) %></section>
<section class="card"><h2>Documentation</h2><div class="documentation-grid"><% for(const d of documentation){ %><article><a href="/images/proof/<%= d.id %>" target="_blank" rel="noopener"><img class="proof-thumbnail" src="/images/proof/<%= d.id %>" alt="Proof for LOG-<%= d.id %>"></a><p><%= d.fullname %> — <%= d.created_at %></p></article><% } %><% if(!documentation.length){ %><p>No documentation yet.</p><% } %></div></section>
<section class="card"><h2>Quick Actions</h2><div class="quick-actions"><a href="/resources">Resources</a><a href="/notifications">Notifications &amp; Receipts</a><a href="/complaints">Complaints</a><a href="/history">History</a><% if(user.role==='admin'){ %><a href="/farmers">Farmers List</a><a href="/trash">Trash</a><% }else{ %><a href="/profile">My Profile</a><% } %></div></section><%- include('partials/foot') %>
