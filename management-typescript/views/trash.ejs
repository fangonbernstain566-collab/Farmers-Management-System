<%- include('partials/head') %><header class="page-header"><h1>Trash Bin</h1></header><section class="card"><h2>Deleted Items</h2><div class="table-wrap"><table><thead><tr><th>Item Type</th><th>Reference</th><th>Actions</th></tr></thead><tbody><% let total=0;for(const [table,records] of Object.entries(items)){for(const r of records){total++; %><tr><td><%= {users:'Farmer Account',resources:'Resource',distributions:'Distribution Record',complaints:'Complaint'}[table] %></td><td>#<%= r.id %> — <%= r.label %></td><td class="actions"><form action="/trash/<%= table %>/<%= r.id %>/restore" method="post" data-confirm="Restore this item?"><%- include('partials/csrf') %><button>Restore</button></form><form action="/trash/<%= table %>/<%= r.id %>/delete" method="post" data-confirm="Permanently delete this item and its related distributions? This cannot be undone."><%- include('partials/csrf') %><button class="danger">Delete Permanently</button></form></td></tr><% }}if(!total){ %><tr><td colspan="3">Trash Bin is Empty.</td></tr><% } %></tbody></table></div></section><%- include('partials/foot') %>
