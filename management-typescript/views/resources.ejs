<%- include('partials/head') %><header class="page-header"><h1>Resource Management</h1></header>
<% if(user.role==='admin'){ %><section class="card"><h2>Add New Resource</h2><form action="/resources" method="post"><%- include('partials/csrf') %><div class="form-grid"><label>Resource Name<input name="name" maxlength="100" required></label><label>Quantity<input name="total_quantity" type="number" min="0.0001" max="99999999999" step="0.0001" required></label><label>Unit<input name="unit" maxlength="20" required></label></div><button>➕ Add Resource</button></form></section><% } %>
<section class="card"><h2>Available Resources Analytics</h2><div class="bar-chart"><% const max=Math.max(1,...resources.map(r=>Number(r.total_quantity)));for(const r of resources){ %><div class="bar-row"><span><%= r.name %></span><meter min="0" max="<%= max %>" value="<%= r.total_quantity %>"><%= r.total_quantity %></meter><span><%= r.total_quantity %> <%= r.unit %></span></div><% } %></div></section>
<section class="card"><h2>Resource Inventory</h2><% if(user.role==='admin'){ %><form action="/resources/distribute" method="post" data-confirm="Distribute all available stock proportionally based on active farmers’ hectares?"><%- include('partials/csrf') %><button>🚀 Distribute All Resources</button></form><% } %>
<form action="/resources/delete" method="post" data-confirm="Move selected resources to Trash?"><%- include('partials/csrf') %><div class="table-wrap"><table><thead><tr><% if(user.role==='admin'){ %><th><label><input type="checkbox" data-select-all>All</label></th><% } %><th>Reference</th><th>Resource</th><th>Available Stock</th><th>Unit</th><th>Status</th></tr></thead><tbody><% for(const r of resources){ %><tr><% if(user.role==='admin'){ %><td><input type="checkbox" name="selected_resources" value="<%= r.id %>" aria-label="Select <%= r.name %>"></td><% } %><td>RES-<%= String(r.id).padStart(5,'0') %></td><td><%= r.name %></td><td><%= r.total_quantity %></td><td><%= r.unit %></td><td><%= Number(r.total_quantity)>0?'Available':'Out of stock' %></td></tr><% } %><% if(!resources.length){ %><tr><td colspan="6">No resources found.</td></tr><% } %></tbody></table></div><% if(user.role==='admin'){ %><button class="danger">🗑 Delete Selected</button><% } %></form></section>
<% if(user.role==='admin'){ %><section class="card"><h2>Farmer Beneficiaries</h2><div class="table-wrap"><table><thead><tr><th>Farmer</th><th>Contact Number</th><th>Registered Farm Area</th></tr></thead><tbody><% for(const f of farmers){ %><tr><td><a href="/profile?id=<%= f.id %>"><%= f.fullname %></a><br><%= f.address %></td><td><%= f.contact_number %></td><td><%= f.hectares %> ha</td></tr><% } %></tbody></table></div></section><% } %><%- include('partials/foot') %>
