<%- include('partials/head') %><script src="/assets/vendor/html2canvas.min.js" defer></script><article id="receipt-export" class="card printable-receipt"><img src="/assets/logo.png" alt="Aringay Agriculture" class="receipt-logo"><h1>Digital Distribution Receipt</h1><p>Aringay Agriculture · REC-<%= String(receipt.id).padStart(6,'0') %></p><p>Farmer: <%= receipt.fullname %></p><p>Date Issued: <%= receipt.created_at %></p><p>Status: <%= records.some(r=>r.status==='pending')?'pending':'received' %></p><div class="table-wrap"><table><thead><tr><th>Resource</th><th>Quantity</th><th>Unit</th></tr></thead><tbody><% for(const d of records){ %><tr><td><%= d.resource_name %></td><td><%= d.allocated_quantity %></td><td><%= d.unit %></td></tr><% } %></tbody></table></div><% if(receipt.proof_image){ %><img class="receipt-proof" src="/images/proof/<%= receipt.id %>" alt="Receipt proof"><p>Received: <%= receipt.received_at %></p><% } %><button type="button" data-receipt-png="Receipt-REC-<%= String(receipt.id).padStart(6,'0') %>" data-html2canvas-ignore="true" class="no-print">Save Receipt PNG</button><button type="button" data-print data-html2canvas-ignore="true" class="no-print">Print / Save as PDF</button><a href="/notifications" data-html2canvas-ignore="true" class="no-print">Back to notifications</a></article><%- include('partials/foot') %>
