<%- include('partials/head') %><header class="page-header"><h1>Complaints</h1></header>
<% if(user.role==='farmer'||edit){ %><section class="card"><h2><%= edit?'Edit Complaint':'Submit a Complaint' %></h2><form action="<%= edit?'/complaints/'+edit.id+'/edit':'/complaints' %>" method="post" enctype="multipart/form-data" data-confirm="Save this complaint?"><%- include('partials/csrf') %><label>Subject<input name="subject" maxlength="150" value="<%= edit?.subject??'' %>" required></label><label>Message<textarea name="message" rows="5" maxlength="20000" required><%= edit?.message??'' %></textarea></label><label>Picture (optional, JPG/PNG/WEBP, max 5 MB)<input name="complaint_image" type="file" accept="image/jpeg,image/png,image/webp"></label><button><%= edit?'Save Changes':'Send Complaint' %></button><% if(edit){ %><a href="/complaints">Cancel</a><% } %></form></section><% } %>
<section class="card"><h2><%= user.role==='admin'?'Complaints Record':'My Complaints' %></h2><% if(!complaints.length){ %><p>No complaints yet.</p><% } %><div class="complaint-list"><% for(const c of complaints){ %><article class="complaint-card"><header><h3><%= c.subject %></h3><span class="status-pill status-<%= c.status %>"><%= c.status %></span></header><p class="muted"><%= c.fullname %> · <%= c.created_at %></p><p class="message"><%= c.message %></p><% if(c.image_path){ %><a href="/images/complaint/<%= c.id %>" target="_blank" rel="noopener">View picture</a><% } %><div class="actions"><a href="/complaints?edit=<%= c.id %>">Edit</a><form action="/complaints/<%= c.id %>/delete" method="post" data-confirm="Move this complaint to Trash?"><%- include('partials/csrf') %><button class="danger">Delete</button></form><% if(user.role==='admin'&&c.status==='pending'){ %><form action="/complaints/<%= c.id %>/confirm" method="post" data-confirm="Confirm this complaint and notify the farmer?"><%- include('partials/csrf') %><button>Confirm Complaint</button></form><% } %></div></article><% } %></div></section><%- include('partials/foot') %>
