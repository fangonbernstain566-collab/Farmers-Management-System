<%- include('partials/head') %><header class="page-header"><h1>👨‍🌾 Farmers Management</h1></header>
<% if(edit){ %><section class="card"><h2>✏️ Edit Official Farmer Record</h2><form action="/farmers/<%= edit.id %>/edit" method="post" enctype="multipart/form-data" data-confirm="Save farmer information?"><%- include('partials/csrf') %><div class="form-grid"><%- include('partials/fields',{record:edit}) %><label>Registered Farm Area (Hectares)<input name="hectares" type="number" step="0.01" min="0" max="99999999.99" value="<%= edit.hectares %>" required></label><label>Profile Photo<input name="profile_pic" type="file" accept="image/jpeg,image/png,image/webp"></label></div><button>💾 Save Changes</button><a href="/farmers">Cancel</a></form></section><% } %>
<section class="card"><h2>Registered Farmers Directory</h2><form action="/farmers" method="get" class="search-form"><label>Search name, contact, address, or ID<input name="search" value="<%= search %>" maxlength="100"></label><button>Search</button><a href="/farmers">Clear</a></form>
<div class="table-wrap"><table><thead><tr><th>Photo</th><th>Farmer</th><th>Address</th><th>Farm Area</th><th>Actions</th></tr></thead><tbody><% for(const f of farmers){ %><tr><td><% if(f.profile_pic&&f.profile_pic!=='default.png'){ %><img class="avatar" src="/images/profile/<%= f.id %>" alt="<%= f.fullname %>"><% }else{ %>👤<% } %></td><td><%= f.fullname %><br><small><%= f.contact_number %></small></td><td><%= f.address %></td><td><%= f.hectares %> ha</td><td><a href="/profile?id=<%= f.id %>">View Profile</a> · <a href="/farmers?edit=<%= f.id %>">Edit</a><form action="/farmers/<%= f.id %>/delete" method="post" data-confirm="Move this farmer to Trash?"><%- include('partials/csrf') %><button class="danger">Delete</button></form></td></tr><% } %><% if(!farmers.length){ %><tr><td colspan="5">No farmers found.</td></tr><% } %></tbody></table></div></section><%- include('partials/foot') %>
