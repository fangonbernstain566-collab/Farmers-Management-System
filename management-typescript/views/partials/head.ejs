<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | Aringay Agriculture</title><link rel="stylesheet" href="/assets/style.css"><link rel="stylesheet" href="/assets/legacy-pages.css"><link rel="stylesheet" href="/assets/app.css"><script src="/assets/app.js" defer></script></head><body class="<%= user ? 'app-page' : 'auth-page' %>">
<% if(flash){ %><div class="toast toast-<%= flash.type %>" role="status"><span class="toast-message"><%= flash.message %></span><button type="button" class="toast-close" aria-label="Dismiss message">×</button></div><% } %>
<% if(user){ %><div class="app-container"><aside class="sidebar"><div class="sidebar-brand"><img src="/assets/logo.png" class="sidebar-logo" alt="Aringay Agriculture logo"><div class="sidebar-brand-text"><strong>Farm Management</strong><span class="account-label"><%= user.role==='admin'?'Admin Account':'Farmer Account' %></span><span class="location-label">Aringay Agriculture</span></div></div><nav aria-label="Main navigation"><ul class="sidebar-menu">
<% const links=[['/dashboard','🏠','Dashboard'],['/resources','🌱','Resources'],['/notifications','🔔','Notifications'],['/history','📋','History'],['/complaints','💬','Complaints'],...(user.role==='admin'?[['/farmers','👨‍🌾','Farmers List'],['/trash','🗑️','Trash']]:[['/profile','👤','My Profile']])];for(const [href,icon,label] of links){ %><li><a href="<%= href %>" class="<%= path===href?'active':'' %>"><span class="menu-icon" aria-hidden="true"><%= icon %></span><span class="menu-text"><%= label %></span><% if(href==='/notifications'&&unread){ %><span class="notification-badge"><%= unread>99?'99+':unread %></span><% } %></a></li><% } %>
<li class="logout-item"><form action="/logout" method="post" data-confirm="End your session?"><%- include('csrf') %><button class="logout-button" type="submit">🚪 Logout</button></form></li></ul></nav></aside><main class="content"><% } %>
