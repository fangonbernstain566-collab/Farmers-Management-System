<%- include('partials/head') %>
<script src="/assets/vendor/html2canvas.min.js" defer></script>
<header class="page-header no-print"><div><span class="eyebrow">Distribution documentation</span><h1>Receipt</h1><p>Review and save your official distribution receipt.</p></div><a class="button button-secondary" href="/notifications"><%- include('partials/icon', { name: 'arrow-left' }) %> Back to notifications</a></header>
<article id="receipt-export" class="card printable-receipt">
  <div class="receipt-heading"><img src="/assets/logo.png" alt="Aringay Agriculture" class="receipt-logo"><div><h2>Digital Distribution Receipt</h2><p>Aringay Agriculture · REC-<%= String(receipt.id).padStart(6, '0') %></p></div></div>
  <% const receiptStatus = records.some(r => r.status === 'pending') ? 'pending' : receipt.status; %>
  <dl class="profile-details"><dt>Farmer</dt><dd><%= receipt.fullname %></dd><dt>Date issued</dt><dd><%= receipt.created_at %></dd><dt>Status</dt><dd><span class="status-pill status-<%= receiptStatus %>"><%= receiptStatus %></span></dd></dl>
  <div class="table-wrap" tabindex="0" role="region" aria-label="Receipt resources"><table><thead><tr><th scope="col">Resource</th><th scope="col">Quantity</th><th scope="col">Unit</th></tr></thead><tbody><% for (const d of records) { %><tr><td><%= d.resource_name %></td><td class="quantity"><%= d.allocated_quantity %></td><td><%= d.unit %></td></tr><% } %></tbody></table></div>
  <% if (receipt.proof_image) { %><h3 class="receipt-proof-heading">Proof of receipt</h3><img class="receipt-proof" src="/images/proof/<%= receipt.id %>" alt="Receipt proof"><p class="muted">Received: <%= receipt.received_at %></p><% } %>
  <div class="form-actions no-print" data-html2canvas-ignore="true">
    <button type="button" data-receipt-png="Receipt-REC-<%= String(receipt.id).padStart(6, '0') %>"><%- include('partials/icon', { name: 'download' }) %> Save PNG</button>
    <button type="button" class="button-outline" data-print><%- include('partials/icon', { name: 'printer' }) %> Print / save PDF</button>
  </div>
</article>
<%- include('partials/foot') %>
