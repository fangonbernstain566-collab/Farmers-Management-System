<%- include('partials/head') %>
<section class="card error-card">
  <span class="dialog-icon"><%- include('partials/icon', { name: 'circle-alert' }) %></span>
  <h1><%= title %></h1>
  <p role="alert"><%= message %></p>
  <div class="form-actions"><a class="button" href="<%= user ? '/dashboard' : '/login' %>"><%- include('partials/icon', { name: 'arrow-left' }) %> Return to <%= user ? 'dashboard' : 'sign in' %></a><button type="button" class="button-secondary" data-back>Back to form</button></div>
</section>
<%- include('partials/foot') %>
