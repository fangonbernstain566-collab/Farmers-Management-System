<%- include('partials/head') %>
<header class="page-header"><div><span class="eyebrow">System</span><h1>Trash</h1><p>Restore deleted items or permanently remove records you no longer need.</p></div></header>
<section class="card">
  <div class="section-heading"><div><h2>Deleted items</h2><p>Permanent deletion cannot be undone and may remove related distributions.</p></div><%- include('partials/icon', { name: 'trash-2' }) %></div>
  <div class="table-wrap" tabindex="0" role="region" aria-label="Deleted items table"><table><thead><tr><th scope="col">Item type</th><th scope="col">Reference</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>
    <% let total = 0; for (const [table, records] of Object.entries(items)) { for (const r of records) { total++; %>
    <tr><td><%= { users: 'Farmer account', resources: 'Resource', distributions: 'Distribution record', complaints: 'Complaint' }[table] %></td><td>#<%= r.id %> · <%= r.label %></td><td><span class="status-pill status-deleted">Deleted</span></td><td><div class="actions">
      <form action="/trash/<%= table %>/<%= r.id %>/restore" method="post" data-confirm="Restore this item?" data-confirm-title="Restore item?" data-confirm-label="Restore"><%- include('partials/csrf') %><button class="button-outline button-small" type="submit"><%- include('partials/icon', { name: 'rotate-ccw' }) %> Restore</button></form>
      <form action="/trash/<%= table %>/<%= r.id %>/delete" method="post" data-confirm="Permanently delete this item and its related distributions? This cannot be undone." data-confirm-title="Permanently delete item?" data-confirm-label="Delete permanently" data-confirm-danger="true"><%- include('partials/csrf') %><button class="danger button-small" type="submit"><%- include('partials/icon', { name: 'trash-2' }) %> Delete permanently</button></form>
    </div></td></tr>
    <% } } if (!total) { %><tr><td colspan="4"><%- include('partials/empty', { icon: 'trash-2', heading: 'Trash is empty', description: 'Items moved to Trash will appear here for restoration or removal.' }) %></td></tr><% } %>
  </tbody></table></div>
</section>
<%- include('partials/foot') %>
