<%- include('partials/head') %>
<header class="page-header"><div><span class="eyebrow">Management</span><h1>Farmers</h1><p>Manage registered farmers and their agricultural land information.</p></div><span class="status-pill status-active"><%= farmers.length %> listed</span></header>
<% if (edit) { %>
<section class="card">
  <div class="section-heading"><div><h2>Edit farmer record</h2><p>Update the official registration for <%= edit.fullname %>.</p></div></div>
  <p class="form-note">Fields marked <span class="required" aria-hidden="true">*</span> are required.</p>
  <form action="/farmers/<%= edit.id %>/edit" method="post" enctype="multipart/form-data" data-confirm="Save farmer information?" data-confirm-title="Save changes?" data-confirm-label="Save changes">
    <%- include('partials/csrf') %>
    <fieldset class="form-section"><legend>Personal information</legend><div class="form-grid"><%- include('partials/fields', { record: edit }) %></div></fieldset>
    <fieldset class="form-section"><legend>Farm &amp; profile information</legend><div class="form-grid">
      <label>Registered farm area (hectares) <span class="required" aria-hidden="true">*</span><input name="hectares" type="number" step="0.01" min="0" max="99999999.99" value="<%= edit.hectares %>" required><span class="form-help">Use up to two decimal places.</span></label>
      <label>Profile photo<input name="profile_pic" type="file" accept="image/jpeg,image/png,image/webp"><span class="form-help">JPG, PNG, or WEBP · maximum 5 MB. Leave empty to keep the current photo.</span></label>
    </div></fieldset>
    <div class="form-actions"><button type="submit"><%- include('partials/icon', { name: 'save' }) %> Save changes</button><a class="button button-secondary" href="/farmers">Cancel</a></div>
  </form>
</section>
<% } %>
<section class="card">
  <div class="section-heading"><div><h2>Registered farmers</h2><p>Search the existing farmer directory.</p></div></div>
  <form action="/farmers" method="get" class="search-form">
    <label>Search name, contact, address, or ID<span class="search-input"><%- include('partials/icon', { name: 'search' }) %><input name="search" type="search" value="<%= search %>" maxlength="100" placeholder="Search farmers"></span></label>
    <button type="submit">Search</button><a class="button button-secondary" href="/farmers">Clear</a>
  </form>
  <div class="table-wrap" tabindex="0" role="region" aria-label="Registered farmers table"><table><thead><tr><th scope="col">Photo</th><th scope="col">Farmer</th><th scope="col">Address</th><th scope="col">Farm area</th><th scope="col">Actions</th></tr></thead><tbody>
    <% for (const f of farmers) { %>
    <tr><td><% if (f.profile_pic && f.profile_pic !== 'default.png') { %><img class="avatar" src="/images/profile/<%= f.id %>" alt="<%= f.fullname %>" loading="lazy"><% } else { %><span class="avatar-placeholder"><%- include('partials/icon', { name: 'circle-user-round' }) %></span><% } %></td>
      <td><strong><%= f.fullname %></strong><small><%= f.contact_number %></small></td><td><%= f.address %></td><td class="quantity"><%= f.hectares %> ha</td>
      <td><div class="actions"><a class="button button-ghost button-small" href="/profile?id=<%= f.id %>" title="View farmer profile"><%- include('partials/icon', { name: 'eye' }) %> View</a><a class="button button-ghost button-small" href="/farmers?edit=<%= f.id %>" title="Edit farmer"><%- include('partials/icon', { name: 'pencil' }) %> Edit</a>
        <form action="/farmers/<%= f.id %>/delete" method="post" data-confirm="This farmer will be moved to Trash and can be restored later." data-confirm-title="Move farmer to Trash?" data-confirm-label="Move to Trash" data-confirm-danger="true"><%- include('partials/csrf') %><button class="danger button-small" type="submit"><%- include('partials/icon', { name: 'trash-2' }) %> Delete</button></form>
      </div></td></tr>
    <% } if (!farmers.length) { %><tr><td colspan="5"><%- include('partials/empty', { icon: 'users', heading: search ? 'No matching farmers' : 'No farmers yet', description: search ? 'Try another name, contact number, address, or ID.' : 'Registered farmer accounts will appear in this directory.' }) %></td></tr><% } %>
  </tbody></table></div>
</section>
<%- include('partials/foot') %>
