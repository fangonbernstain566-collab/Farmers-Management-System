<%- include('partials/head') %><div class="auth-container <%= mode==='register'?'auth-register-card':'auth-login-card' %>"><img src="/assets/logo.png" alt="Farm Logo" class="logo"><h2><%= title %></h2>
<form action="/<%= mode==='hectares'?'setup-hectares':mode %>" method="post" <% if(mode!=='login'){ %>data-confirm="Save this information?"<% } %>><%- include('partials/csrf') %>
<% if(mode==='hectares'){ %><p>Please enter the total hectares you own to calculate resource allocation.</p><label>Hectares Owned<input type="number" step="0.01" min="0.01" max="99999999.99" name="hectares" required></label><button>Save &amp; Continue</button>
<% }else{ %><% if(mode==='register'){ %><div class="form-grid"><%- include('partials/fields',{record:null}) %></div><% } %><label>Email Address<input type="email" name="email" maxlength="100" autocomplete="email" required></label><label>Password<input type="password" name="password" autocomplete="<%= mode==='register'?'new-password':'current-password' %>" required></label><% if(mode==='register'){ %><p class="muted">Use 8 or more characters with uppercase, lowercase, a number, and a symbol. Maximum 72 bytes.</p><% } %><button><%= mode==='login'?'Sign In':'Register Account' %></button><% } %></form>
<% if(mode==='login'){ %><p>New Farmer? <a href="/register">Register Account</a></p><% }else if(mode==='register'){ %><p>Already have an account? <a href="/login">Login</a></p><% } %></div><%- include('partials/foot') %>
