<div class="table-wrap"><table><thead><tr><th>Log Reference</th><% if(user.role==='admin'){ %><th>Farmer</th><% } %><th>Resource</th><th>Quantity</th><th>Status</th><th>Date Issued</th><th>Proof</th><% if(user.role==='admin'){ %><th>Documentation</th><% } %></tr></thead><tbody>
<% for(const d of records){ %><tr><td>LOG-<%= String(d.id).padStart(5,'0') %></td><% if(user.role==='admin'){ %><td><a href="/profile?id=<%= d.farmer_id %>"><%= d.fullname %></a></td><% } %><td><%= d.resource_name %></td><td><%= d.allocated_quantity %> <%= d.unit %></td><td><span class="status-pill status-<%= d.status %>"><%= d.status %></span></td><td><%= d.created_at %></td><td><% if(d.proof_image){ %><a href="/images/proof/<%= d.id %>" target="_blank" rel="noopener">View Proof</a><% }else{ %>—<% } %> <a href="/receipts/<%= d.id %>">Receipt</a></td><% if(user.role==='admin'){ %><td><form action="/distributions/<%= d.id %>/delete" method="post" data-confirm="Delete documentation and notify the farmer?"><%- include('csrf') %><label>Deletion reason<input name="deletion_reason" maxlength="2000" required></label><button class="danger">Delete</button></form></td><% } %></tr><% } %>
<% if(!records.length){ %><tr><td colspan="8">No distribution history yet.</td></tr><% } %></tbody></table></div>
