<div class="table-wrap" tabindex="0" role="region" aria-label="Distribution records table">
  <table><thead><tr><th scope="col">Reference</th><% if (user.role === 'admin') { %><th scope="col">Farmer</th><% } %><th scope="col">Resource</th><th scope="col">Allocated quantity</th><th scope="col">Status</th><th scope="col">Date issued</th><th scope="col">Receipt &amp; proof</th><% if (user.role === 'admin') { %><th scope="col">Documentation</th><% } %></tr></thead><tbody>
    <% for (const d of records) { %>
    <tr><td class="reference">LOG-<%= String(d.id).padStart(5, '0') %></td>
      <% if (user.role === 'admin') { %><td><a href="/profile?id=<%= d.farmer_id %>"><%= d.fullname %></a></td><% } %>
      <td><%= d.resource_name %></td><td class="quantity"><%= d.allocated_quantity %> <%= d.unit %></td><td><span class="status-pill status-<%= d.status %>"><%= d.status %></span></td><td><%= d.created_at %></td>
      <td><div class="actions"><a class="button button-ghost button-small" href="/receipts/<%= d.id %>"><%- include('icon', { name: 'receipt-text' }) %> Receipt</a><%- include('proof-button', { distribution: d, showThumbnail: false }) %></div></td>
      <% if (user.role === 'admin') { %><td><form class="table-form" action="/distributions/<%= d.id %>/delete" method="post" data-confirm="This distribution record will be moved to Trash and the farmer will be notified with your reason." data-confirm-title="Delete documentation?" data-confirm-label="Move to Trash" data-confirm-danger="true"><%- include('csrf') %><label>Deletion reason <span class="required" aria-hidden="true">*</span><input name="deletion_reason" maxlength="2000" required></label><button class="danger button-small" type="submit"><%- include('icon', { name: 'trash-2' }) %> Delete</button></form></td><% } %>
    </tr>
    <% } if (!records.length) { %><tr><td colspan="<%= user.role === 'admin' ? 8 : 6 %>"><%- include('empty', { icon: 'truck', heading: 'No distributions yet', description: 'Resource allocations and their receipt status will appear here.' }) %></td></tr><% } %>
  </tbody></table>
</div>
