NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Preferred backend connection for Supabase PostgreSQL.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE
DB_HOST=YOUR_POSTGRES_HOST
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD
DB_TLS=true
UPLOAD_DIR=./storage/uploads
# Set 1 only behind one trusted proxy with direct access blocked.
TRUST_PROXY=0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Aringay Agriculture
SMTP_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=3
EMAIL_BATCH_SIZE=25
EMAIL_RETRY_DELAY_SECONDS=300
# Optional override of SMTP_ENCRYPTION: true for implicit TLS, false for STARTTLS.
# SMTP_SECURE=false
